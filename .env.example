# Safe example values only. Do not commit real API keys.
APP_ENV=test
STAGE=prod
CONFIG_PATH=config.yml
DR_DATA_DIR=data
DEEP_RESEARCH_LOG_DIR=logs

# Offline-safe defaults for local inspection and CI.
ALLOW_LIVE_EXTERNAL_APIS=false
LLM_PROVIDER=fake
SEARCH_PROVIDER=fake
CHECKPOINTER_BACKEND=sqlite

# The API listens on loopback unless API_HOST is explicitly changed.
API_HOST=127.0.0.1

# Worker runtime
HEARTBEAT_INTERVAL_SECONDS=10
CLAIM_TTL_SECONDS=30
WORKER_MAX_ATTEMPTS=3
ORPHAN_GRACE_SECONDS=60
ORPHAN_SWEEP_INTERVAL_SECONDS=60

# Memory 3.0 feature switches: memory_off needs BOTH gates = off.
DR_MEMORY_READ_ENABLED=on
DR_MEMORY_WRITE_ENABLED=on
# Optional, isolates Chroma + episodes by experiment (relative to repo root).
# DR_MEMORY_DATA_DIR=data/ablation/my-variant
DR_MEMORY_V3_ENABLED=on
DR_MEMORY_HYBRID_RETRIEVAL=on
DR_MEMORY_STRUCTURED_RETRIEVAL=on
DR_MEMORY_TEMPORAL_LINKS=on
DR_MEMORY_CONTEXT_MAX_CHARS=5500
DR_STAGE_MEMORY_ENABLED=on
DR_STAGE_MEMORY_MAX_CHARS=2200
DR_EPISODIC_MEMORY_ENABLED=on
DR_MEMORY_OUTBOX_ENABLED=on
# Set to off when running a dedicated `python -m backend.memory_worker` process.
DR_MEMORY_OUTBOX_POLL_ON_WORKER=on

# Research / writer behavior (Quality Gate V3 is the only supported graph).
DR_WRITER_CONTEXT_BUDGET=on
# Auto rounds 0..3 and HITL-provided rounds 0..5 are persisted at Brief checkpoint.
DR_MAX_AUTO_RESEARCH_ROUNDS=2
DR_MAX_MANUAL_RESEARCH_ROUNDS=2
DR_CLAIM_VERIFY_THINKING=off
DR_WRITER_THINKING=off
DR_DRAFT_THINKING=off
DR_SUPERVISOR_THINKING=on


# Multi-user accounts (server-side only; use distinct random secrets >=32 chars)
# DR_API_USERS_JSON={"alice":"REPLACE_WITH_LONG_RANDOM_SECRET_32_CHARS"}
