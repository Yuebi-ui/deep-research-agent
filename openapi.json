            "title": "Thread Id",
            "type": "string"
          },
          "verification": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verification"
          }
        },
        "required": [
          "thread_id"
        ],
        "title": "ReportResponse",
        "type": "object"
      },
      "ResearchRequest": {
        "description": "提交研究任务的请求。",
        "properties": {
          "query": {
            "description": "研究主题/问题",
            "maxLength": 5000,
            "minLength": 1,
            "title": "Query",
            "type": "string"
          },
          "run_id": {
            "anyOf": [
              {
                "maxLength": 64,
                "pattern": "^[A-Za-z0-9_.-]{1,64}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "baseline 观测 run 标识（可选）",
            "title": "Run Id"
          }
        },
        "required": [
          "query"
        ],
        "title": "ResearchRequest",
        "type": "object"
      },
      "ReviewAction": {
        "description": "Human Review 审查决定。",
        "properties": {
          "action": {
            "description": "V3：approve、revise_draft、more_research",
            "pattern": "^(approve|revise_draft|more_research)$",
            "title": "Action",
            "type": "string"
          },
          "feedback": {
            "default": "",
            "description": "修改草稿或定向补研的具体要求；V3 限 500 字",
            "title": "Feedback",
            "type": "string"
          }
        },
        "required": [
          "action"
        ],
        "title": "ReviewAction",
        "type": "object"
      },
      "ReviewResponse": {
        "properties": {
          "ok": {
            "default": true,
            "title": "Ok",
            "type": "boolean"
          },
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "thread_id"
        ],
        "title": "ReviewResponse",
        "type": "object"
      },
      "StatsResponse": {
        "additionalProperties": true,
        "description": "全局统计摘要。",
        "properties": {
          "quality_stats": {
            "additionalProperties": true,
            "title": "Quality Stats",
            "type": "object"
          },
          "total_cost_rmb": {
            "default": 0.0,
            "title": "Total Cost Rmb",
            "type": "number"
          },
          "total_input_tokens": {
            "default": 0,
            "title": "Total Input Tokens",
            "type": "integer"
          },
          "total_llm_calls": {
            "default": 0,
            "title": "Total Llm Calls",
            "type": "integer"
          },
          "total_output_tokens": {
            "default": 0,
            "title": "Total Output Tokens",
            "type": "integer"
          },
          "total_tasks": {
            "default": 0,
            "title": "Total Tasks",
            "type": "integer"
          },
          "total_tokens": {
            "default": 0,
            "title": "Total Tokens",
            "type": "integer"
          },
          "total_trace_events": {
            "default": 0,
            "title": "Total Trace Events",
            "type": "integer"
          }
        },
        "title": "StatsResponse",
        "type": "object"
      },
      "TaskCreatedResponse": {
        "description": "POST /api/research/start 的响应。",
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "status",
          "created_at"
        ],
        "title": "TaskCreatedResponse",
        "type": "object"
      },
      "TaskListItem": {
        "description": "历史任务列表项。",
        "properties": {
          "created_at": {
            "title": "Created At",
            "type": "string"
          },
          "query": {
            "title": "Query",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          },
          "updated_at": {
            "title": "Updated At",
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "query",
          "status",
          "created_at",
          "updated_at"
        ],
        "title": "TaskListItem",
        "type": "object"
      },
      "TaskSummaryResponse": {
        "description": "任务状态快照。\n\n任务状态通过数据库投影返回，\n另加 Phase G 引入的运行时元数据（attempt / cancel_requested）。",
        "properties": {
          "attempt": {
            "default": 0,
            "title": "Attempt",
            "type": "integer"
          },
          "cancel_requested": {
            "default": false,
            "title": "Cancel Requested",
            "type": "boolean"
          },
          "draft_report": {
            "default": "",
            "title": "Draft Report",
            "type": "string"
          },
          "error": {
            "default": "",
            "title": "Error",
            "type": "string"
          },
          "final_report": {
            "default": "",
            "title": "Final Report",
            "type": "string"
          },
          "query": {
            "default": "",
            "title": "Query",
            "type": "string"
          },
          "stage": {
            "default": "",
            "title": "Stage",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          },
          "verification": {
            "anyOf": [
              {
                "additionalProperties": true,
                "type": "object"
              },
              {
                "type": "null"
              }
            ],
            "title": "Verification"
          }
        },
        "required": [
          "thread_id",
          "status"
        ],
        "title": "TaskSummaryResponse",
        "type": "object"
      },
      "TraceGraphResponse": {
        "additionalProperties": true,
        "description": "执行轨迹图（nodes / edges）。\n\n图结构本身是开放的（节点类型会随 Agent 演进增加），因此节点与边\n声明为 ``extra=\"allow\"``：已知字段有类型，未知字段原样透传，\n不会因为加了 response_model 而把新字段悄悄过滤掉。",
        "properties": {
          "edges": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Edges",
            "type": "array"
          },
          "nodes": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Nodes",
            "type": "array"
          }
        },
        "title": "TraceGraphResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
