{
  "components": {
    "schemas": {
      "AlertsResponse": {
        "description": "告警概览。\n\n阈值可配置、维度可扩展，因此 `alerts` 内部保留开放结构\n—— 属 §7.3 允许的「字段本质上就是开放 JSON metadata」。",
        "properties": {
          "alerts": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Alerts",
            "type": "array"
          },
          "alerts_count": {
            "default": 0,
            "title": "Alerts Count",
            "type": "integer"
          },
          "thresholds": {
            "additionalProperties": {
              "type": "number"
            },
            "title": "Thresholds",
            "type": "object"
          }
        },
        "title": "AlertsResponse",
        "type": "object"
      },
      "CancelResponse": {
        "properties": {
          "ok": {
            "default": true,
            "title": "Ok",
            "type": "boolean"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          }
        },
        "required": [
          "thread_id",
          "status"
        ],
        "title": "CancelResponse",
        "type": "object"
      },
      "CostByModel": {
        "additionalProperties": true,
        "properties": {
          "calls": {
            "default": 0,
            "title": "Calls",
            "type": "integer"
          },
          "cost_rmb": {
            "default": 0.0,
            "title": "Cost Rmb",
            "type": "number"
          },
          "input_tokens": {
            "default": 0,
            "title": "Input Tokens",
            "type": "integer"
          },
          "output_tokens": {
            "default": 0,
            "title": "Output Tokens",
            "type": "integer"
          }
        },
        "title": "CostByModel",
        "type": "object"
      },
      "CostDetailResponse": {
        "additionalProperties": true,
        "description": "单任务成本明细。\n\n字段与前端 `CostDashboard.tsx` 消费的保持一致。\n`model_stats` 以模型名为键、`records` 为原始记录列表，二者都是\n开放结构。",
        "properties": {
          "model_stats": {
            "additionalProperties": {
              "$ref": "#/components/schemas/CostByModel"
            },
            "title": "Model Stats",
            "type": "object"
          },
          "records": {
            "items": {
              "additionalProperties": true,
              "type": "object"
            },
            "title": "Records",
            "type": "array"
          },
          "thread_id": {
            "title": "Thread Id",
            "type": "string"
          },
          "total_cost_rmb": {
            "default": 0.0,
            "title": "Total Cost Rmb",
            "type": "number"
          },
          "total_input_tokens": {
            "default": 0,
            "title": "Total Input Tokens",
            "type": "integer"
          },
          "total_output_tokens": {
            "default": 0,
            "title": "Total Output Tokens",
            "type": "integer"
          },
          "total_tokens": {
            "default": 0,
            "title": "Total Tokens",
            "type": "integer"
          }
        },
        "required": [
          "thread_id"
        ],
        "title": "CostDetailResponse",
        "type": "object"
      },
      "DeleteResponse": {
        "properties": {
          "deleted": {
            "default": true,
            "title": "Deleted",
            "type": "boolean"
          }
        },
        "title": "DeleteResponse",
        "type": "object"
      },
      "HTTPValidationError": {
